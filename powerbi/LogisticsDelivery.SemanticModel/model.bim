            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ],
        "measures": [
          {
            "name": "Cohort Orders",
            "expression": "COUNTROWS(FactDelivery)",
            "lineageTag": "fff4792e-4b47-5c71-b79a-99a53b0659c3",
            "formatString": "#,0",
            "displayFolder": "Delivery service"
          },
          {
            "name": "Eligible Deliveries",
            "expression": "SUM(FactDelivery[eligible_flag])",
            "lineageTag": "bbb76157-76dc-57c4-9178-e3017f71d485",
            "formatString": "#,0",
            "displayFolder": "Delivery service"
          },
          {
            "name": "Delivered Status Orders",
            "expression": "SUM(FactDelivery[delivered_flag])",
            "lineageTag": "273a0044-58bb-5b56-8333-47bea7af9e7a",
            "formatString": "#,0",
            "displayFolder": "Delivery service"
          },
          {
            "name": "Late Deliveries",
            "expression": "SUM(FactDelivery[late_flag])",
            "lineageTag": "c0ef91e9-6e1c-586f-9fd8-9ce8ef6709bf",
            "formatString": "#,0",
            "displayFolder": "Delivery service"
          },
          {
            "name": "On Time Deliveries",
            "expression": "[Eligible Deliveries] - [Late Deliveries]",
            "lineageTag": "fa81bd32-3894-57f5-ba87-c2899c76d5f9",
            "formatString": "#,0",
            "displayFolder": "Delivery service"
          },
          {
            "name": "On Time Delivery %",
            "expression": "DIVIDE([On Time Deliveries], [Eligible Deliveries])",
            "lineageTag": "6ac49f23-061b-58b8-aa79-eb2837073992",
            "formatString": "0.00%",
            "displayFolder": "Delivery service"
          },
          {
            "name": "Late Delivery %",
            "expression": "DIVIDE([Late Deliveries], [Eligible Deliveries])",
            "lineageTag": "089a1fe7-23d0-53dc-86d8-e7b0b8f2e193",
            "formatString": "0.00%",
            "displayFolder": "Delivery service"
          },
          {
            "name": "Eligibility Coverage %",
            "expression": "DIVIDE([Eligible Deliveries], [Cohort Orders])",
            "lineageTag": "caf136d9-9614-5960-9987-43b13dff3271",
            "formatString": "0.00%",
            "displayFolder": "Delivery service"
          },
          {
            "name": "Median Delivery Days",
            "expression": "DIVIDE(MEDIAN(FactDelivery[delivery_seconds]), 86400)",
            "lineageTag": "63b8004d-d4ba-569d-86c1-ef80e382384e",
            "formatString": "0.00",
            "displayFolder": "Delivery service"
          },
          {
            "name": "P90 Delivery Days",
            "expression": "IF([Eligible Deliveries] > 0, PERCENTILEX.INC(FILTER(FactDelivery, FactDelivery[eligible_flag] = 1), FactDelivery[delivery_seconds] / 86400.0, 0.9))",
            "lineageTag": "d545fc82-4c30-5293-98d2-ca96c1f94b5e",
            "formatString": "0.00",
            "displayFolder": "Delivery service"
          },
          {
            "name": "Mean Processing Days",
            "expression": "DIVIDE(AVERAGE(FactDelivery[processing_seconds]), 86400)",
            "lineageTag": "0b087b7e-0ec5-58a5-90e7-568123ae41e0",
            "formatString": "0.00",
            "displayFolder": "Delivery service"
          },
          {
            "name": "Mean Post Handover Days",
            "expression": "DIVIDE(AVERAGE(FactDelivery[post_handover_seconds]), 86400)",
            "lineageTag": "49a675b9-9e6a-592c-9915-b91069e1791d",
            "formatString": "0.00",
            "displayFolder": "Delivery service"
          },
          {
            "name": "Complete Stage Orders",
            "expression": "SUM(FactDelivery[stage_valid_flag])",
            "lineageTag": "9403d438-26cf-5ff6-a3f7-314a55869ad3",
            "formatString": "#,0",
            "displayFolder": "Delivery service"
          },
          {
            "name": "Stage Coverage %",
            "expression": "DIVIDE([Complete Stage Orders], [Eligible Deliveries])",
            "lineageTag": "47025858-eed2-5b28-a9ab-e7b88dbbb122",
            "formatString": "0.00%",
            "displayFolder": "Delivery service"
          },
          {
            "name": "Severe Late Deliveries",
            "expression": "SUM(FactDelivery[severe_late_flag])",
            "lineageTag": "b2ba6a23-d1e8-554d-845a-01f9b27b08d9",
            "formatString": "#,0",
            "displayFolder": "Delivery service"
          },
          {
            "name": "Reviewed Eligible Orders",
            "expression": "SUM(FactDelivery[reviewed_eligible_flag])",
            "lineageTag": "e50aa60f-a4f4-566d-b9ba-9cb564849d95",
            "formatString": "#,0",
            "displayFolder": "Feedback and evidence"
          },
          {
            "name": "Low Score Orders",
            "expression": "SUM(FactDelivery[poor_review_flag])",
            "lineageTag": "a5a6c5aa-4dc5-55f1-b4e2-9712ceb4b2c8",
            "formatString": "#,0",
            "displayFolder": "Feedback and evidence"
          },
          {
            "name": "Low Score %",
            "expression": "DIVIDE([Low Score Orders], [Reviewed Eligible Orders])",
            "lineageTag": "1eca8068-c622-5c1b-9199-7129084f6eb2",
            "formatString": "0.00%",
            "displayFolder": "Feedback and evidence"
          },
          {
            "name": "Review Coverage %",
            "expression": "DIVIDE([Reviewed Eligible Orders], [Eligible Deliveries])",
            "lineageTag": "0ef9eb55-f4e7-5833-8bd1-ac0ddd8b1f0f",
            "formatString": "0.00%",
            "displayFolder": "Feedback and evidence"
          },
          {
            "name": "Noneligible Orders",
            "expression": "[Cohort Orders] - [Eligible Deliveries]",
            "lineageTag": "874cf104-5e97-52a2-8bcf-435222c4c954",
            "formatString": "#,0",
            "displayFolder": "Delivery service"
          },
          {
            "name": "Previous Month OTD %",
            "expression": "CALCULATE([On Time Delivery %], DATEADD(DimDate[date], -1, MONTH))",
            "lineageTag": "fa1532b7-49d7-5c96-9967-5aed7f8b28d3",
            "formatString": "0.00%",
            "displayFolder": "Delivery service"
          },
          {
            "name": "OTD Change pp",
            "expression": "IF(NOT ISBLANK([Previous Month OTD %]), 100 * ([On Time Delivery %] - [Previous Month OTD %]))",
            "lineageTag": "fdda225c-055e-5d07-88d9-a8e2bcf6b421",
            "formatString": "0.00\" pp\"",
            "displayFolder": "Delivery service"
          },
          {
            "name": "Top Eight State Late Orders",
            "expression": "IF(SELECTEDVALUE(DimState[late_volume_rank], 999) <= 8, [Late Deliveries])",
            "lineageTag": "d09794a6-bb8a-5619-ae40-ec58f03c52ca",
            "formatString": "#,0",
            "displayFolder": "Delivery service"
          },
          {
            "name": "Comparable Category Late %",
            "expression": "IF([Eligible Deliveries] >= 100, [Late Delivery %])",
            "lineageTag": "2ad2dd92-d859-5fe8-b49f-81a23f72d953",
            "formatString": "0.00%",
            "displayFolder": "Delivery service"
          }
        ]
      },
