    "expressions": [
      {
        "name": "pDataFolder",
        "kind": "m",
        "expression": "\"C:/LogisticsDelivery/data/processed/\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]"
      },
      {
        "name": "fxLoadCsv",
        "kind": "m",
        "expression": "(FileName as text, ColumnTypes as list) as table =>\nlet\n    Source = Csv.Document(File.Contents(pDataFolder & FileName), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),\n    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),\n    EmptyToNull = Table.ReplaceValue(Headers, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),\n    Typed = Table.TransformColumnTypes(EmptyToNull, ColumnTypes, \"en-GB\")\nin Typed\n"
      }
    ],
    "annotations": [
      {
        "name": "PBI_TimeIntelligenceEnabled",
        "value": "0"
      },
